class ArrayHomework 
{
	public static void main(String[] args) 
	{
		ArrayHomework M1 = new ArrayHomwwork
		
	}
	public void Sum()
		{
			int arr[] = new int[5];
			arr[0] = 12;
			arr[1] = 13;
			arr[2] = 14;
			arr[3] = 15;
			arr[4] = 16;
			int sum = 0;
		
			for (int i=0; i<5 ; i++ )
			{
				sum = sum + arr[i];
			}
			System.out.println("Total Sum Of The Array : "+(sum) );
		}
}
